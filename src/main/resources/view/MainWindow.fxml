<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane minHeight="420.0" minWidth="360.0"
            prefHeight="600.0" prefWidth="400.0"
            styleClass="main-root"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="MainWindow">
    <children>
        <VBox spacing="12.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" styleClass="content-shell">
            <Label text="Hamtaro's Cozy Corner" styleClass="app-title" />
            <Label text="Squeak! Let's get your tasks sorted." styleClass="app-subtitle" />
            <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER"
                        minHeight="0.0" minWidth="0.0" vbarPolicy="AS_NEEDED"
                        VBox.vgrow="ALWAYS" styleClass="conversation-pane">
                <content>
                    <VBox fx:id="dialogContainer" fillWidth="true" spacing="8.0"
                          styleClass="dialog-container" />
                </content>
            </ScrollPane>
            <HBox spacing="10.0" styleClass="input-bar">
                <TextField fx:id="userInput" promptText="Tell Hamtaro what to do..."
                           onAction="#handleUserInput" HBox.hgrow="ALWAYS" />
                <Button fx:id="sendButton" mnemonicParsing="false"
                        onAction="#handleUserInput" text="Squeak!" defaultButton="true" />
            </HBox>
        </VBox>
    </children>
</AnchorPane>

